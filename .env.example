# Copy to .env and fill in. Every other dotenv file is gitignored.
#
# THE TWO REQUIRED VARIABLES ARE LEFT BLANK ON PURPOSE. A copied-but-unedited
# file should stop the process at boot with the variable's name in
# `systemctl status`, not start a bot that authenticates as nobody. See
# src/config.ts.
#
# NOTHING IN THE SOURCE READS THIS FILE. `npm start` hands node
# `--env-file-if-exists=.env` and that is the whole of the mechanism; there is
# no dotenv dependency to do it behind your back. The path is relative and npm
# runs from the directory holding package.json, so `.env` belongs beside it —
# /opt/blitz-bot/.env on the box. Under systemd the unit supplies the same
# variables itself through `EnvironmentFile=` (docs/deploy.md).
#
# A VARIABLE ALREADY SET IN THE ENVIRONMENT BEATS THE LINE HERE. This file
# fills in what is missing and overrides nothing, so if editing a value appears
# to do nothing, something else set it first — most often an `export` still
# alive in the shell you are starting the bot from.

# Required. Discord Developer Portal -> your app -> Bot -> Reset Token.
DISCORD_BOT_TOKEN=

# Required. Right-click your Discord server -> Copy Server ID (Developer Mode on).
DISCORD_GUILD_ID=

# Optional. Role id treated as admin; unset disables the admin exemption entirely.
DISCORD_ADMIN_ROLE_ID=

# Optional. Channel id that removals are logged to; unset means journal only.
BLITZ_LOG_CHANNEL_ID=

# Optional. Channel id the bot posts its own warnings and errors to, and the commit it
# came up on when that has changed since the last time it said; unset means journal only.
BLITZ_STATUS_CHANNEL_ID=

# Optional. Channel id the bot keeps docs/bot-manual.md posted in, one embed per top-level
# heading, reconciled at every start; unset turns the manual off and nothing is read or posted.
BLITZ_DOCS_CHANNEL_ID=

# Optional. Comma-separated channel ids the scanner skips. Default: none skipped.
BLITZ_EXEMPT_CHANNEL_IDS=

# Optional. "true" or "false". Skip messages from DISCORD_ADMIN_ROLE_ID holders. Default: true.
BLITZ_EXEMPT_ADMINS=true

# Optional. "true" or "false". Scan and log but delete nothing. Default: false.
BLITZ_DRY_RUN=false
