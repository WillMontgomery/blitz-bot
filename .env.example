# Copy to .env and fill in. Every other dotenv file is gitignored.
#
# THE TWO REQUIRED VARIABLES ARE LEFT BLANK ON PURPOSE. A copied-but-unedited
# file should stop the process at boot with the variable's name in
# `systemctl status`, not start a bot that authenticates as nobody. See
# src/config.ts.
#
# NOTHING IN THE SOURCE READS THIS FILE. `npm start` hands node
# `--env-file-if-exists=.env` and that is the whole of the mechanism; there is
# no dotenv dependency to do it behind your back. The path is relative and npm
# runs from the directory holding package.json, so `.env` belongs beside it —
# /opt/blitz-bot/.env on the box. Under systemd the unit supplies the same
# variables itself through `EnvironmentFile=` (docs/deploy.md).
#
# A VARIABLE ALREADY SET IN THE ENVIRONMENT BEATS THE LINE HERE. This file
# fills in what is missing and overrides nothing, so if editing a value appears
# to do nothing, something else set it first — most often an `export` still
# alive in the shell you are starting the bot from.

# Required. Discord Developer Portal -> your app -> Bot -> Reset Token.
DISCORD_BOT_TOKEN=

# Required. Right-click your Discord server -> Copy Server ID (Developer Mode on).
DISCORD_GUILD_ID=

# Optional. Role id treated as admin. It answers two questions, and unset means the
# opposite thing in each — both of which are the safe direction. For moderation it turns
# the admin exemption on: unset means nobody is skipped and every message is scanned. For
# admin-only slash commands it is the gate: unset means nobody holds the role, so those
# commands refuse everybody rather than letting everybody in.
DISCORD_ADMIN_ROLE_ID=

# Optional. Channel id the moderation record goes in: removals, an embed for every
# incident the game files, and an embed for every incident closed in the Ringmaster
# console. Unset means journal only — and it also means neither the console's audit log
# nor the incidents index is polled at all.
BLITZ_LOG_CHANNEL_ID=

# Optional. Channel id the bot posts its own warnings and errors to, and the commit it
# came up on when that has changed since the last time it said; unset means journal only.
BLITZ_STATUS_CHANNEL_ID=

# Optional. Channel id the bot keeps docs/bot-manual.md posted in, one embed per top-level
# heading, reconciled at every start; unset turns the manual off and nothing is read or posted.
BLITZ_DOCS_CHANNEL_ID=

# Optional. Channel id the server's outage is announced in, for players to read: ONE message, when
# the game is back up and joinable. Nothing is posted when a window is scheduled, when the door
# shuts on new players, when the server goes down, or when a window is cancelled. That one message
# waits for the game server itself to report in rather than for the deploy to finish, and says so
# instead if it never does. Unset turns the watcher off and the maintenance row is never read.
BLITZ_MAINTENANCE_CHANNEL_ID=

# Optional. Comma-separated channel ids the scanner skips. Default: none skipped.
BLITZ_EXEMPT_CHANNEL_IDS=

# Optional. Comma-separated IPv4 addresses of this community's own game servers. A message
# carrying any other IPv4-shaped string is removed, so a third server goes on this line rather
# than into a code change. Blank or unset means the two shown here, NOT an empty list — an empty
# one would delete the message that names your own server. A malformed entry stops the bot at boot.
# Each entry must be canonical dotted-quad: four octets of 0-255, no leading zeros (14.22.5.3, not
# 014.22.05.03) and no IPv6. Those are the only spellings the matcher can produce, so anything else
# would be a line that exempts nothing.
# THE ORDER MATTERS FOR ONE THING: the FIRST address is the one the maintenance channel tells
# players to connect to when the server comes back up. Put the box people join at the front.
BLITZ_SERVER_IPS=3.130.92.28,18.222.244.205

# Optional. "true" or "false". Skip messages from DISCORD_ADMIN_ROLE_ID holders. Default: true.
BLITZ_EXEMPT_ADMINS=true

# Optional. "true" or "false". Scan and log but delete nothing. Default: false.
BLITZ_DRY_RUN=false

# --- The moderation mirror ----------------------------------------------------
# Discord's own ban, unban and kick, carried into the game. The bot listens for the
# guild's audit log entries and writes the ban straight to DynamoDB; only the LIVE
# kick — removing somebody from a match already in progress — needs the Ringmaster
# console, because the SSH channel to the game box belongs to the console.
#
# THE BOT NEVER DEPENDS ON THE CONSOLE BEING UP. With the console down the ban is
# still written and is still enforced at the banned player's next connect; what is
# lost is the immediate removal, which is retried for a few minutes and then dropped
# on purpose rather than delivered late into somebody else's match.

# Optional. The shared secret the console's command routes want, presented in the
# x-ringmaster-service header. THE SAME VALUE UNDER THE SAME NAME lives in the
# console's own /opt/ringmaster/.env.local, which is why this one variable carries no
# BLITZ_ prefix: it belongs to the pair of services, like DISCORD_BOT_TOKEN, and not
# to this bot. Generate it there (openssl rand -base64 32) and copy it here.
#
# Unset means live kicks are not attempted at all — the bans are still written, and
# every mirrored ban puts one warning in the status channel saying so.
COMMAND_SECRET=

# Optional. Where the Ringmaster console answers. Origin only: scheme, host and port,
# with no path, query or fragment — a stray path makes every call a 404 that reads
# exactly like a console that is down. Blank or unset means the address below, NOT
# "off": this bot is the second service on the console's own box and the console
# listens there, so the address is a fact about the deployment. COMMAND_SECRET is the
# switch that turns the relay off, and it is the only one.
#
# The loopback deliberately, not the public hostname. Going out through Cloudflare and
# back would put the shared secret on the public internet to reach a process on the
# same machine, and port 3000 is closed to the internet for that reason.
BLITZ_RINGMASTER_URL=http://127.0.0.1:3000

# Optional. The role assigned to somebody banned in the GAME but not from Discord, so
# they keep limited access and can discuss it. A Discord ban means banned in the game
# permanently; a game ban never means a Discord ban. Lifting or expiring the game ban
# removes the role. Blank or unset means the id shown here, NOT "no role" — a blank
# line is what an unedited template looks like, and the only thing "no role" could
# mean is a settled policy quietly half-applied. A malformed id stops the bot at boot.
#
# TWO THINGS IN THE GUILD HAVE TO BE RIGHT OR NOTHING IS MARKED. The bot needs the
# Manage Roles permission, and THIS ROLE MUST SIT BELOW THE BOT'S OWN ROLE in Server
# Settings -> Roles: Discord refuses a role edit unless the acting member's highest
# role is above the role being assigned, and a new role lands at the bottom of nobody's
# list in particular. Both are checked when the bot starts and before every edit, and a
# failure is one line in the status channel naming which of them is wrong.
BLITZ_GAME_BAN_ROLE_ID=1542596612306505808

# --- The game ban going the other way ----------------------------------------
# A ban issued in the CONSOLE puts the role above on the player, and lifting or
# EXPIRING it takes the role off. Discord is told nothing when that happens, so the
# bot watches the console's own audit table and re-checks the bans it has marked.
# There is nothing to configure — it is wired for every deployment — but two things
# about it are worth knowing before a deploy.
#
# THE SERVER MEMBERS INTENT HAS TO BE TICKED ON, in the Discord Developer Portal:
# your app -> Bot -> Privileged Gateway Intents -> Server Members Intent. It is what
# delivers the join event, and the join event is how somebody banned in the game who
# is not in the Discord gets marked when they arrive. GETTING THIS WRONG TAKES THE
# WHOLE BOT DOWN, not just this feature: the gateway rejects the connection with close
# code 4014 and systemd restarts into the same wall. `journalctl -u blitz-bot | grep
# 4014` is the evidence.
#
# BANS ISSUED BEFORE THIS SHIPPED ARE NOT BACKFILLED. The bot marks bans from the
# moment it first starts with this feature; there is no way to ask "who is banned right
# now" without scanning the ban table, which this bot deliberately cannot do. Existing
# bans get their role when the console next re-issues one, or when the player joins.
